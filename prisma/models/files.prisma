model File {
    id   String @id @unique @default(uuid())
    path String @unique

    fileName String
    fileSize BigInt
    fileType String

    uploadStatus String @default("pending")

    parent String?
    sharedFile SharedFile[]

    owner   User   @relation(fields: [ownerId], references: [id])
    ownerId String
}

model CurrentAudio {
    id          String    @id @unique @default(uuid())
    url         String
    duration    BigInt
    currentTime BigInt
    audioStatus String
    data        RoomData?
}

model SharedFile {
    id  String @id @unique @default(uuid())
    file File   @relation(fields: [fileId], references: [id])
    fileId String @unique

    url String @unique
}