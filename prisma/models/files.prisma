model File {
    id   String @id @unique @default(uuid())
    path String @unique

    fileName String
    fileSize BigInt
    fileType String

    uploadStatus String @default("pending")

    parent String?

    owner   User   @relation(fields: [ownerId], references: [id])
    ownerId String
}

model CurrentAudio {
    id          String    @id @unique @default(uuid())
    url         String
    duration    String
    currentTime BigInt
    audioStatus String
    data        RoomData?
}
